{
  "name": "tracelens",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "bin": {
    "tracelens": "scripts/tracelens.mjs"
  },
  "files": [
    "dist",
    "scripts/tracelens.mjs",
    "scripts/local-server.mjs",
    "scripts/agent-capture.mjs",
    "scripts/local-evaluations.mjs",
    "scripts/trace-validator.mjs",
    "scripts/eval-demo.mjs",
    "scripts/pydantic_evals_demo.py",
    "scripts/pydantic_evals_export.py",
    "scripts/requirements-evals.txt",
    "docs/local-use.md",
    "docs/pydantic-evals.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "prestart": "npm run build",
    "start": "node scripts/tracelens.mjs",
    "capture": "node scripts/tracelens.mjs run",
    "evals": "node scripts/tracelens.mjs eval demo",
    "test:local": "node --test scripts/local-product.test.mjs scripts/eval-demo.test.mjs",
    "prepack": "npm run build",
    "pack:app": "node scripts/package-app.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "tsc --noEmit",
    "test:release": "node --test scripts/prepare-release.test.mjs",
    "test:cli": "node scripts/cli-smoke.mjs",
    "prepare:github": "node scripts/prepare-release.mjs"
  },
  "devDependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
